{
    "name": "@aurora-launcher/launcher",
    "version": "0.0.5-dev.2",
    "private": true,
    "description": "Launcher for Minecraft",
    "homepage": "https://github.com/AuroraTeam/Launcher#readme",
    "bugs": {
        "url": "https://github.com/AuroraTeam/Launcher/issues"
    },
    "license": "MIT",
    "author": "AuroraTeam",
    "contributors": [
        "JoCat (https://github.com/JoCat)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AuroraTeam/Launcher.git"
    },
    "main": "out/main/index-obf.loader.js",
    "scripts": {
        "dev": "cross-env DEV=true electron-vite dev -w --entry ./out/main/index.js -- --dev",
        "build": "electron-vite build && pnpm run obfuscator && pnpm run bytenode && esbuild ./script/electron-build.ts --bundle --log-level=error --loader:.pem=text --platform=node --packages=external --format=esm --outdir=./script/ --out-extension:.js=.mjs && node ./script/electron-build.mjs",
        "start": "electron-vite preview --entry ./out/main/index.js",
        "clean": "rimraf out dist",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "pack": "electron-builder --dir",
        "release": "esbuild ./script/upload-release.ts --bundle --log-level=error --loader:.pem=text --platform=node --packages=external --format=esm --outdir=./script/ --out-extension:.js=.mjs && node ./script/upload-release.mjs",
        "obfuscator": "javascript-obfuscator out/main/index.js --output out/main/index-obf.js --split-strings true --split-strings-chunk-length 8",
        "bytenode": "bytenode -c out/main/index-obf.js -e -l --compress",
        "test": "vitest"
    },
    "dependencies": {
        "@aurora-launcher/core": "workspace:^",
        "@freshgum/typedi": "^0.7.2",
        "@kostya-main/discord-rpc": "^1.2.1",
        "bytenode": "^1.7.0",
        "chokidar": "^5.0.0",
        "electron-store": "^12.0.0",
        "electron-updater": "^6.8.9",
        "i18next": "^24.2.3",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-resources-to-backend": "^1.2.3",
        "jotai": "^3.0.1",
        "lucide-react": "^1.59.0",
        "minestat-es": "^3.2.0",
        "node-stream-zip": "^1.16.0",
        "p-map": "^7.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^15.7.4",
        "react-router-dom": "^7.18.4",
        "semver": "^7.8.5",
        "skinview3d": "^3.4.2",
        "source-map-support": "^0.5.21",
        "undici": "^6.29.1",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@types/ws": "^8.18.2",
        "cross-env": "^10.1.0",
        "electron": "^38.8.6",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "javascript-obfuscator": "^5.9.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "rimraf": "^6.1.3",
        "sass": "^1.105.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    },
    "importSort": {
        ".tsx, .ts, .mjs, .js": {
            "style": "module",
            "parser": "typescript"
        }
    }
}
